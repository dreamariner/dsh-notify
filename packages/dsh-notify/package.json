{
  "name": "@dreamariner/dsh-notify",
  "description": "DSH 回合结束系统通知：回合跑完弹一条系统通知，归属是 DSH 本身，点一下唤起 DSH Desktop",
  "version": "0.2.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.types.json",
    "dev": "tsdown --watch",
    "prepare": "tsdown && tsc -p tsconfig.types.json && node ../../scripts/sync-pack-docs.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-notify"
  ],
  "license": "Apache-2.0",
  "author": "Jianan",
  "homepage": "https://github.com/dreamariner/dsh-notify",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamariner/dsh-notify",
    "directory": "packages/dsh-notify"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "js-yaml": "^4.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9",
    "vitest": "^5.0.3",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "react": "^18.2.0",
    "@types/react": "^18.2.0"
  }
}
